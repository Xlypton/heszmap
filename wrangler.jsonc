// Cloudflare Workers Builds: build with `npm run build`, then `npx wrangler deploy` serves dist/ as static assets.
// worker/index.js only handles /x/* (the external overlay tile proxy); every other path is a static asset.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heszmap",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/x/*"]
  },
  // Branch builds run `npx wrangler preview`, which refuses to run without this block (it may stay empty).
  "previews": {}
}
