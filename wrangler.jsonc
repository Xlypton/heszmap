// Cloudflare Workers Builds: build with `npm run build`, then `npx wrangler deploy` serves dist/ as static assets.
// worker/index.js runs first for every path: it checks the Basic Auth login (secrets AUTH_USER, AUTH_PASS),
// then serves /x/* (the external overlay tile proxy) itself and everything else from dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heszmap",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Branch builds run `npx wrangler preview`, which refuses to run without this block (it may stay empty).
  "previews": {}
}
